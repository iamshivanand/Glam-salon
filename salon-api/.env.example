# Runtime (least-privilege app role, subject to RLS)
DATABASE_URL=postgres://glam_app:glam_app_pw@127.0.0.1:5433/glamconnect
# Migrations / seeding (owner/superuser)
MIGRATE_DATABASE_URL=postgres://glam:glam_dev_pw@127.0.0.1:5433/glamconnect
REDIS_URL=redis://127.0.0.1:6380

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=dev_jwt_secret_change_me_please_0123456789
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# 32-byte hex keys (64 chars)
PHONE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_PEPPER=dev_phone_pepper_change_me

# Dev convenience: return OTP in API response and expose dev login
DEV_RETURN_OTP=true

# Public web origin used in reminder deep links
APP_PUBLIC_URL=http://localhost:3000

# Notifications: auto | console | webhook | twilio | whatsapp_cloud | resend
# `auto` wires whichever credentials below are present, then falls back to the
# console provider in development. Console is refused in production unless
# ALLOW_CONSOLE_NOTIFICATIONS=true.
NOTIFICATION_PROVIDER=auto
OTP_CHANNEL=SMS
# ALLOW_CONSOLE_NOTIFICATIONS=false

# Generic internal notification service / automation webhook
# NOTIFY_WEBHOOK_URL=https://notify.example.com/glam
# NOTIFY_WEBHOOK_SECRET=change_me

# Twilio (SMS and/or WhatsApp)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SMS_FROM=+14155550100
# TWILIO_WHATSAPP_FROM=+14155550100

# Meta WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend transactional email
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Glam Connect <hello@yourdomain.com>

# In-process reminder dispatcher. Set false when running `npm run dispatch` from cron.
REMINDER_DISPATCH_ENABLED=true
REMINDER_DISPATCH_INTERVAL_SEC=30
REMINDER_MAX_ATTEMPTS=3
