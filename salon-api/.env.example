# Runtime (least-privilege app role, subject to RLS)
DATABASE_URL=postgres://glam_app:glam_app_pw@127.0.0.1:5433/glamconnect
# Migrations / seeding (owner/superuser)
MIGRATE_DATABASE_URL=postgres://glam:glam_dev_pw@127.0.0.1:5433/glamconnect
REDIS_URL=redis://127.0.0.1:6380

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=dev_jwt_secret_change_me_please_0123456789
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# 32-byte hex keys (64 chars)
PHONE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_PEPPER=dev_phone_pepper_change_me

# Dev convenience: return OTP in API response and expose dev login
DEV_RETURN_OTP=true

# Public web origin used in reminder deep links
APP_PUBLIC_URL=http://localhost:3000
# Public API origin used for click redirects and provider callbacks
API_PUBLIC_URL=http://localhost:4000

# Notifications: auto | console | webhook | twilio | whatsapp_cloud | resend
# `auto` wires whichever credentials below are present, then falls back to the
# console provider in development. Console is refused in production unless
# ALLOW_CONSOLE_NOTIFICATIONS=true.
NOTIFICATION_PROVIDER=auto
OTP_CHANNEL=SMS
# Channel used for booking/queue/invoice messages: SMS | WHATSAPP | EMAIL
TRANSACTIONAL_CHANNEL=SMS
# ALLOW_CONSOLE_NOTIFICATIONS=false

# Generic internal notification service / automation webhook
# NOTIFY_WEBHOOK_URL=https://notify.example.com/glam
# NOTIFY_WEBHOOK_SECRET=change_me
# Secret used by POST /webhooks/notifications (HMAC-SHA256, x-notify-signature)
# DELIVERY_WEBHOOK_SECRET=change_me

# Twilio (SMS and/or WhatsApp)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_SMS_FROM=+14155550100
# TWILIO_WHATSAPP_FROM=+14155550100
# JSON map of template code -> Twilio Content SID
# TWILIO_CONTENT_SID_MAP={"OTP_V1":"HX..."}

# Meta WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_VERIFY_TOKEN=choose_a_verify_token
# Business-initiated messages need approved templates. Leave disabled until the
# templates in WHATSAPP_TEMPLATE_MAP are approved.
# WHATSAPP_TEMPLATES_ENABLED=true
# WHATSAPP_TEMPLATE_MAP={"OTP_V1":"otp_verification","BOOKING_CONFIRMED":"booking_confirmed"}

# Resend transactional email
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Glam Connect <hello@yourdomain.com>

# Expo Push (PUSH reminders). Tokens are registered via POST /users/me/devices.
# EXPO_ACCESS_TOKEN=ExponentPushToken[...]

# Payments: none | manual | razorpay
# `manual` records pay-at-salon intent only; `razorpay` calls the live API.
PAYMENT_PROVIDER=manual
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=change_me

# S3-compatible storage for avatars, KYC documents and style photos.
# The API signs PUT URLs (declared content type is part of the signature) and
# verifies size/type with a HEAD at POST /uploads/confirm. Images are limited to
# 5 MB and PDFs to 10 MB server-side; a presigned PUT alone cannot enforce size.
# MinIO example: S3_ENDPOINT=http://127.0.0.1:9000
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true

# In-process reminder dispatcher. Set false when running `npm run dispatch` from cron.
REMINDER_DISPATCH_ENABLED=true
REMINDER_DISPATCH_INTERVAL_SEC=30
REMINDER_MAX_ATTEMPTS=3

# Prometheus text endpoint at /metrics. Set false to disable.
# METRICS_ENABLED=true
# When set, /metrics requires Bearer <token> (required in production).
# METRICS_TOKEN=

GOOGLE_CLIENT_ID=your_google_oauth_client_id